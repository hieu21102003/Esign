# Sao chép thành .env (chỉ chứa cấu hình không nhạy cảm; mọi bí mật đặt trong thư mục secrets/).
ADMIN_USERNAME=admin
PKI_HOST_DIR=./pki-data
SECRETS_DIR=./secrets
COOKIE_SECURE=true
ORG=Tecco1
CRL_BASE=http://192.168.1.66/pki

# Link gốc của ứng dụng (tùy chọn — bỏ trống nếu không muốn đính kèm link mở tài liệu trong email)
# APP_BASE_URL=https://esign.smart-rail.vn

# Email SMTP (tùy chọn; mật khẩu đặt tại secrets/smtp_pass, KHÔNG đặt SMTP_PASS vào .env trừ khi cần dự phòng)
# SMTP_HOST=gir05.nhanhoa.com
# SMTP_PORT=587
# SMTP_USER=info@smart-rail.vn
# SMTP_FROM=info@smart-rail.vn
# SMTP_TLS=true
